# Copy to .env and fill in, or export in your shell.
# LLM_PROVIDER picks the free-tier route: gemini (default) or groq.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MEKO_API_KEY=
MEKO_DATAPACK_ID=
# MCP endpoint is the same hosted URL for every account/datapack.
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
